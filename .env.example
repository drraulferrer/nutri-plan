# ── Frontend (variables de build, públicas) ─────────────────────────────
# URL de la Edge Function `api` (Fase 2). Vacío ⇒ la app funciona en modo local (Fase 1).
VITE_API_BASE_URL=
VITE_BOT_USERNAME=Nutri_RF_Bot

# ── Backend (Supabase secrets, NUNCA en el frontend ni en git) ─────────
# supabase secrets set BOT_TOKEN=... BOT_SHARED_SECRET=... ALLOWED_ORIGIN=...
BOT_TOKEN=
BOT_SHARED_SECRET=
ALLOWED_ORIGIN=https://drraulferrer.github.io
# Fase 3 (opcional): sin clave, el servidor usa solo el motor de reglas
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
